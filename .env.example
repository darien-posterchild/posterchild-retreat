# Firebase Realtime Database Configuration
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=posterchild-retreat.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=posterchild-retreat
VITE_FIREBASE_STORAGE_BUCKET=posterchild-retreat.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_DATABASE_URL=https://posterchild-retreat-default-rtdb.firebaseio.com

# Active Session Adapter ('local' | 'firebase')
# If set to 'firebase' but Firebase API keys are not provided, it gracefully falls back to 'local'.
VITE_SESSION_ADAPTER=firebase
